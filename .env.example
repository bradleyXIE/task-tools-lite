# Copy to .env and edit. docker compose reads it for interpolation, and the api container loads it too.

# --- Postgres (compose service "postgres") ---
PG_USER=tasktools
PG_PASSWORD=tasktools
PG_DB=tasktools
PG_PORT=5440

# --- Published host ports (loopback only) ---
API_PORT=8010
WEB_PORT=3010

# --- Host dev mode only (./dev.sh, make test). Containers build their own DATABASE_URL. ---
DATABASE_URL=postgresql://tasktools:tasktools@127.0.0.1:5440/tasktools
# Tests use <database>_test on the same server unless you set this. It must end with _test.
# TEST_DATABASE_URL=postgresql://tasktools:tasktools@127.0.0.1:5440/tasktools_test

# --- LLM (required for the task runner; without a key tasks are manual-only) ---
# Option A: Anthropic (default)
LLM_FORMAT=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# LLM_BASE_URL=https://api.anthropic.com      # proxy / gateway; no trailing /v1
#
# Option B: any OpenAI-compatible endpoint (OpenAI, DeepSeek, Qwen, Ollama, vLLM, OpenRouter)
# LLM_FORMAT=openai
# LLM_BASE_URL=https://api.openai.com/v1       # include /v1 (Ollama on the host, from a container: http://host.docker.internal:11434/v1)
# LLM_MODEL=gpt-4.1
# LLM_API_KEY=sk-...                           # Ollama: any non-empty string

# --- Tool limits ---
MAX_STEPS=30
SCRIPT_TIMEOUT=10
HTTP_TOOL_TIMEOUT=15
TOOL_OUTPUT_CAP=20000

# Variables whose names look secret (LLM_*, *_KEY, *_TOKEN, DATABASE_URL, ...) are NOT passed to Bash / shell /
# background processes started by the agent. Forward specific ones deliberately (comma separated):
# TOOL_ENV_PASSTHROUGH=
